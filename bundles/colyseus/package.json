{
  "name": "colyseus",
  "version": "0.18.5",
  "description": "Multiplayer Framework for Node.js",
  "type": "module",
  "input": "./src/index.ts",
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "typings": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.mjs",
      "require": "./build/index.cjs"
    },
    "./vite": {
      "types": "./build/vite.d.ts",
      "import": "./build/vite.mjs",
      "require": "./build/vite.cjs"
    },
    "./plugins/webrtc": {
      "types": "./build/plugins/webrtc.d.ts",
      "import": "./build/plugins/webrtc.mjs",
      "require": "./build/plugins/webrtc.cjs"
    },
    "./plugins/idle-kick": {
      "types": "./build/plugins/idle-kick.d.ts",
      "import": "./build/plugins/idle-kick.mjs",
      "require": "./build/plugins/idle-kick.cjs"
    },
    "./plugins/unique-session": {
      "types": "./build/plugins/unique-session.d.ts",
      "import": "./build/plugins/unique-session.mjs",
      "require": "./build/plugins/unique-session.cjs"
    },
    "./plugins/track-user-sessions": {
      "types": "./build/plugins/track-user-sessions.d.ts",
      "import": "./build/plugins/track-user-sessions.mjs",
      "require": "./build/plugins/track-user-sessions.cjs"
    }
  },
  "scripts": {
    "test": "COLYSEUS_SEAT_RESERVATION_TIME=0.3 COLYSEUS_PRESENCE_SHORT_TIMEOUT=300 mocha test/**.test.ts test/**/**.test.ts --exit --timeout 15000",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "author": "Endel Dreyer",
  "license": "MIT",
  "keywords": [
    "colyseus",
    "multiplayer",
    "netcode",
    "realtime",
    "networking",
    "websockets"
  ],
  "files": [
    "build",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/colyseus/colyseus.git"
  },
  "homepage": "https://colyseus.io/",
  "engines": {
    "node": ">= 22.x"
  },
  "dependencies": {
    "@colyseus/auth": "workspace:^",
    "@colyseus/core": "workspace:^",
    "@colyseus/monitor": "workspace:^",
    "@colyseus/playground": "workspace:^",
    "@colyseus/redis-driver": "workspace:^",
    "@colyseus/redis-presence": "workspace:^",
    "@colyseus/tools": "workspace:^",
    "@colyseus/ws-transport": "workspace:^"
  },
  "devDependencies": {
    "@colyseus/better-call": "workspace:^",
    "@colyseus/core": "workspace:^",
    "@colyseus/drizzle-driver": "workspace:^",
    "@colyseus/schema": "^5.0.8",
    "@colyseus/sdk": "workspace:^",
    "@colyseus/tools": "workspace:^",
    "@colyseus/uwebsockets-transport": "workspace:^",
    "@types/ws": "^8.5.14",
    "ioredis": "^5.9.3",
    "msgpackr": "^2.0.1",
    "ws": "^8.18.0",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "@colyseus/auth": "0.18.x",
    "@colyseus/core": "0.18.x",
    "@colyseus/redis-driver": "0.18.x",
    "@colyseus/redis-presence": "0.18.x",
    "@colyseus/schema": "^5.0.8",
    "@colyseus/uwebsockets-transport": "0.18.x",
    "@colyseus/ws-transport": "0.18.x",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "gitHead": "25ba61e283429bb4fa02db0454f804ea218259eb",
  "publishConfig": {
    "tag": "next"
  }
}
