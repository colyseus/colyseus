{
  "name": "@colyseus/admin",
  "version": "0.18.3",
  "type": "module",
  "description": "Database-backed admin panel for Colyseus (REST + Refine UI, no express)",
  "input": "./src-backend/index.ts",
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "typings": "./build/index.d.ts",
  "exports": {
    ".": {
      "@source": "./src-backend/index.ts",
      "types": "./build/index.d.ts",
      "import": "./build/index.mjs",
      "require": "./build/index.cjs"
    },
    "./*": {
      "@source": "./src-backend/*.ts",
      "types": "./build/*.d.ts",
      "import": "./build/*.mjs",
      "require": "./build/*.cjs"
    }
  },
  "scripts": {
    "start": "vite",
    "build": "vite build && node build.mjs",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "test": "tsx --test test/**.test.ts test/**.test.tsx"
  },
  "files": [
    "build",
    "src-backend"
  ],
  "funding": "https://github.com/sponsors/endel",
  "author": "Endel Dreyer",
  "license": "MIT",
  "keywords": [
    "colyseus",
    "admin",
    "refine",
    "shadcn",
    "tailwindcss",
    "game-backend"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/colyseus/colyseus.git"
  },
  "homepage": "https://colyseus.io/",
  "engines": {
    "node": ">= 22.x"
  },
  "peerDependencies": {
    "@colyseus/auth": "0.18.x",
    "@colyseus/core": "0.18.x",
    "@colyseus/database": "0.18.x"
  },
  "dependencies": {
    "@colyseus/better-call": "workspace:^"
  },
  "devDependencies": {
    "@colyseus/auth": "workspace:^",
    "@colyseus/core": "workspace:^",
    "@colyseus/database": "workspace:^",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@uiw/react-codemirror": "^4.23.7",
    "@refinedev/core": "^4.57.0",
    "@refinedev/react-router": "^1.0.0",
    "@refinedev/simple-rest": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axios": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "1.0.0-rc.2",
    "esbuild": "^0.27.2",
    "fast-glob": "^3.2.12",
    "json-edit-react": "^1.17.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
